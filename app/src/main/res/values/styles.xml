<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.V2ex" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimaryDark">?attr/colorSurface</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorLink">?attr/colorPrimary</item>
        <item name="android:listDivider">@drawable/divider</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <item name="preferenceTheme">@style/AppPreferenceTheme</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>

        <item name="text_medium">@dimen/text_size_medium</item>
        <item name="text_small">@dimen/text_size_small</item>
        <item name="text_large">@dimen/text_size_large</item>

        <item name="item_bg_color">?attr/colorSurface</item>
        <item name="light_background">?attr/colorSurface</item>
        <item name="toolbar_background">?attr/colorSurface</item>
        <item name="status_bar_white">?attr/colorSurface</item>
        <item name="nav_background">?attr/colorSurface</item>
        <item name="bg_refresh">?attr/colorSurfaceVariant</item>
        <item name="bg_login">?attr/colorPrimaryContainer</item>
        <item name="android:windowBackground">?attr/colorBackground</item>
        <item name="android:colorBackground">?attr/colorBackground</item>
        <item name="primary_dark">?attr/colorSurface</item>
    </style>

    <style name="Theme.V2ex.amoled" parent="Theme.V2ex">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">?attr/colorSurface</item>
        <item name="windowSplashScreenBackground" tools:targetApi="s">?attr/colorSurface</item>
    </style>

    <style name="AppPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="android:textSize">?text_medium</item>
    </style>

    <style name="DrawerArrowStyle" parent="@style/Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">?attr/colorPrimary</item>
    </style>


    <style name="Theme.V2ex.big2">
        <item name="text_small">@dimen/text_size_small_2</item>
        <item name="text_medium">@dimen/text_size_medium_2</item>
        <item name="text_large">@dimen/text_size_large_2</item>
    </style>

    <style name="Theme.V2ex.big3">
        <item name="text_small">@dimen/text_size_small_3</item>
        <item name="text_medium">@dimen/text_size_medium_3</item>
        <item name="text_large">@dimen/text_size_large_3</item>
    </style>

    <style name="Theme.V2ex.big4">
        <item name="text_small">@dimen/text_size_small_4</item>
        <item name="text_medium">@dimen/text_size_medium_4</item>
        <item name="text_large">@dimen/text_size_large_4</item>
    </style>

    <style name="Theme.V2ex.amoled.big2">
        <item name="text_small">@dimen/text_size_small_2</item>
        <item name="text_medium">@dimen/text_size_medium_2</item>
        <item name="text_large">@dimen/text_size_large_2</item>
    </style>

    <style name="Theme.V2ex.amoled.big3">
        <item name="text_small">@dimen/text_size_small_3</item>
        <item name="text_medium">@dimen/text_size_medium_3</item>
        <item name="text_large">@dimen/text_size_large_3</item>
    </style>

    <style name="Theme.V2ex.amoled.big4">
        <item name="text_small">@dimen/text_size_small_4</item>
        <item name="text_medium">@dimen/text_size_medium_4</item>
        <item name="text_large">@dimen/text_size_large_4</item>
    </style>

    <style name="Theme.V2ex.Settings">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>

    <style name="Theme.V2ex.ForEdit">
        <item name="colorAccent">?attr/colorPrimary</item>

        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>

        <item name="android:editTextStyle">@style/VEditStyle</item>
        <item name="android:listPreferredItemHeightSmall">36dp</item>
        <item name="android:textAppearanceListItemSmall">@style/VText</item>

    </style>


    <style name="VEditStyle" parent="Widget.AppCompat.EditText">
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingLeft">0dp</item>

    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:textAllCaps">false</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="android:actionMenuTextAppearance">@style/VText</item>
        <item name="android:statusBarColor">?toolbar_background</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:itemTextAppearance">@style/VText</item>
        <item name="android:itemBackground">?item_bg_color</item>
    </style>

    <style name="VTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/VText</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabBackground">?attr/colorSurface</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">10dp</item>
        <item name="tabPaddingEnd">10dp</item>
        <item name="tabMode">scrollable</item>
        <item name="android:layout_height">36sp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="AppTheme.Light.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="AppTheme.Simple" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">?attr/colorOnSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:windowBackground">?light_background</item>
    </style>


    <style name="VText.ExpendedCollapseTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="VText.TitleTextStyle">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">?text_large</item>
    </style>

    <style name="VText.TitleTextStyleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VText">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">?text_medium</item>
    </style>


    <style name="VText.ToolbarStyle">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">?text_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VText.ToolbarStyle.Light">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">?text_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VText.ContentStyle">
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">?text_medium</item>
    </style>

    <style name="VText.Hint">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">?text_small</item>
    </style>


    <style name="TextInputStyle" parent="ThemeOverlay.AppCompat">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
    </style>

    <style name="VText.Login" parent="TextAppearance.AppCompat">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">?text_small</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="VText.LightHint">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">?text_small</item>
    </style>

    <!--底部弹出sheet-->
    <style name="BottomSheetDialogStyle" parent="Theme.Design.BottomSheetDialog">
        <!--<item name="android:windowFrame">@null</item>-->
        <!--<item name="android:windowIsFloating">true</item>-->
        <!--<item name="android:windowIsTranslucent">true</item>-->
        <!--<item name="android:background">@android:color/transparent</item>-->
        <item name="android:backgroundDimEnabled">true</item>
    </style>



    <!-- 圆形图片 -->
    <style name="circleStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>



</resources>
