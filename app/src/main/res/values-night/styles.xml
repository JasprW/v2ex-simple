<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.V2ex" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimaryDark">?attr/colorSurface</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorLink">?attr/colorPrimary</item>
        <item name="android:listDivider">@drawable/divider</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <item name="preferenceTheme">@style/AppPreferenceTheme</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>

        <item name="text_medium">@dimen/text_size_medium</item>
        <item name="text_small">@dimen/text_size_small</item>
        <item name="text_large">@dimen/text_size_large</item>

        <item name="item_bg_color">?attr/colorSurface</item>
        <item name="light_background">?attr/colorSurface</item>
        <item name="toolbar_background">?attr/colorSurface</item>
        <item name="status_bar_white">?attr/colorSurface</item>
        <item name="nav_background">?attr/colorSurface</item>
        <item name="bg_refresh">?attr/colorSurfaceVariant</item>
        <item name="bg_login">?attr/colorPrimaryContainer</item>
        <item name="android:windowBackground">?attr/colorBackground</item>
        <item name="android:colorBackground">?attr/colorBackground</item>
        <item name="primary_dark">?attr/colorSurface</item>
    </style>


    <style name="Theme.V2ex.amoled" parent="Theme.V2ex">
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="item_bg_color">@color/black</item>
        <item name="light_background">@color/black</item>
        <item name="toolbar_background">@color/black</item>
        <item name="status_bar_white">@color/black</item>
        <item name="nav_background">@color/black</item>
        <item name="bg_refresh">@color/black</item>
        <item name="bg_login">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="primary_dark">@color/black</item>
    </style>

</resources>
